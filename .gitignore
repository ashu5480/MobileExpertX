# Dependencies
/node_modules

# Next.js build output
/.next
/out

# Production
/build

# Local env files — never commit real keys.
# `.env` itself is ignored too: it was previously tracked and has been removed
# from the index, but the ignore rule is what stops it coming back.
.env
.env*.local
.env.production
.env.production.local

# Any other file holding credentials — e.g. an Atlas connection string saved
# alongside the repo. These are untracked but MUST stay that way: a `git add .`
# would otherwise publish a live database password.
*-credentials.env
*credentials*.env
*.env.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Testing
/coverage
/tests/.tmp

# Runtime data — the legacy SQLite database and local uploads, kept only so an
# existing local checkout is not confused by them. The app no longer reads or
# writes either: data lives in MongoDB and images in Vercel Blob.
/.data
/public/uploads

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

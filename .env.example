# ─────────────────────────────────────────────────────────────────────────────
#  MobilExpertX — Environment variables
#  Copy to `.env.local` and fill in real values.
#
#  SECURITY RULES
#  • Anything WITHOUT the `NEXT_PUBLIC_` prefix stays on the server and is
#    never sent to the browser. That is where payment secrets belong.
#  • Only publishable keys (Razorpay `key_id`, Stripe `publishable_key`) may
#    use the `NEXT_PUBLIC_` prefix.
#  • `.env.local` must never be committed — it is git-ignored by default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin account ───────────────────────────────────────────────────────────
# Used ONCE, the first time the database is created. After that the account
# lives in the database and the password is changed from the admin panel.
#
# If these are absent the site still boots, but nobody can sign in as admin --
# it fails closed rather than shipping a default password.
#
# Generate a strong password:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_EMAIL=owner@mobilexpertx.com
ADMIN_PASSWORD=
ADMIN_NAME=Store Owner

# ── Local data ──────────────────────────────────────────────────────────────
# Where the SQLite file lives. Defaults to ./.data
# MEX_DATA_DIR=./.data
#
# Set to 1 only when testing a production build over http://localhost, so the
# session cookie is not marked Secure and the browser will send it back.
# MEX_INSECURE_COOKIE=1


# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph and
# the sitemap, so it must be correct in production.
NEXT_PUBLIC_SITE_URL=https://mobilexpertx.com


# ── Contact channels ────────────────────────────────────────────────────────
# E.164 format, digits only, no "+" — used to build wa.me deep links.
NEXT_PUBLIC_WHATSAPP_NUMBER=919716216480

# Display values (spaces and a leading + are fine — they are stripped for links).
NEXT_PUBLIC_CONTACT_PHONE=+91 97162 16480
NEXT_PUBLIC_REPAIR_PHONE=+91 97162 16480

# Founder / point of contact, shown on the contact and about pages.
NEXT_PUBLIC_OWNER_NAME=Ishak Khan

NEXT_PUBLIC_CONTACT_EMAIL=hello@mobilexpertx.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@mobilexpertx.com


# ── Address ─────────────────────────────────────────────────────────────────
# OPTIONAL — leave blank until a public storefront address is decided.
# Every field is empty by default: the footer, contact page and structured
# data all hide the address block when nothing is set. Fill these in to
# publish it again.
NEXT_PUBLIC_ADDRESS_LINE1=
NEXT_PUBLIC_ADDRESS_LINE2=
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_STATE=
NEXT_PUBLIC_PINCODE=

# Country is always published — it drives "area served", shipping and the
# return policy in the JSON-LD, so it stays populated.
NEXT_PUBLIC_COUNTRY=India
NEXT_PUBLIC_COUNTRY_CODE=IN


# ── Opening hours (display only) ────────────────────────────────────────────
NEXT_PUBLIC_HOURS_WEEKDAY=Mon – Sat · 10:00 AM – 8:00 PM
NEXT_PUBLIC_HOURS_SUNDAY=Sunday · 11:00 AM – 6:00 PM
NEXT_PUBLIC_HOURS_DISPLAY=Mon – Sat 10am – 8pm · Sun 11am – 6pm


# ── Social handles (no @, no https://) ──────────────────────────────────────
NEXT_PUBLIC_SOCIAL_INSTAGRAM=mobilexpertx
NEXT_PUBLIC_SOCIAL_FACEBOOK=mobilexpertx
NEXT_PUBLIC_SOCIAL_YOUTUBE=@mobilexpertx
NEXT_PUBLIC_SOCIAL_X=mobilexpertx


# ─────────────────────────────────────────────────────────────────────────────
#  PAYMENTS
# ─────────────────────────────────────────────────────────────────────────────
#  TEST MODE IS THE DEFAULT. With no keys set the checkout runs a clearly
#  labelled simulated payment — it never pretends a real charge happened.
#
#  To go live with Razorpay:
#    1. Set PAYMENT_PROVIDER=razorpay
#    2. Set RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET (server-side ONLY)
#    3. Set NEXT_PUBLIC_RAZORPAY_KEY_ID to the same key id
#
#  To go live with Stripe:
#    1. Set PAYMENT_PROVIDER=stripe
#    2. Set STRIPE_SECRET_KEY (server-side ONLY)
#    3. Set NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#
#  Switching the public provider here only affects the UI label; the
#  authoritative switch is the server-side PAYMENT_PROVIDER below.
# ─────────────────────────────────────────────────────────────────────────────

# Which gateway the browser should talk to: mock | razorpay | stripe
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_CURRENCY=INR

# Razorpay (public — safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay (SECRET — never prefix this with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Payments (SERVER ONLY) ──────────────────────────────────────────────────
# This is the value that actually matters. `mock` simulates; `razorpay` and
# `stripe` fall back to `mock` automatically if their keys are missing, so a
# half-configured deploy can never attempt a real charge.
PAYMENT_PROVIDER=mock


# ── Commerce ────────────────────────────────────────────────────────────────
# Free standard shipping threshold, in paise (499900 = ₹4,999).
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_PAISE=499900

# Optional: point the storefront at a real backend instead of the bundled
# catalogue. Every service in src/services already has a live-fetch path.
# NEXT_PUBLIC_API_BASE_URL=https://api.mobilexpertx.com

# Optional: live pricing partner for the sell-your-phone estimator.
# NEXT_PUBLIC_SELL_PRICING_API_URL=

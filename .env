# ── Admin account ───────────────────────────────────────────────────────────
# Used ONCE, the first time the database is created. After that the account
# lives in the database and you change the password from the admin panel.
# If these are absent, nobody can sign in as admin -- it fails closed.
#
# Generate a strong password:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_EMAIL=owner@mobilexpertx.com
ADMIN_PASSWORD=ChangeMe_Admin_2026
ADMIN_NAME=Ishak Khan

# ── Local data ──────────────────────────────────────────────────────────────
# Where the SQLite file and uploaded images live. Defaults to ./.data
# MEX_DATA_DIR=./.data

# ─────────────────────────────────────────────────────────────────────────────
#  MobilExpertX — local development defaults
#  This file is committed on purpose so a fresh clone runs with zero setup.
#
#  Payments are in TEST MODE — no gateway keys are set, so checkout can never
#  move real money. For real deployment, copy `.env.example` to `.env.local`
#  and fill in live values there; `.env.local` overrides this file and is
#  git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

